{
  "expo": {
    "name": "vium",
    "slug": "vium_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "viumapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vium.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.vium.app"
    },
    "web": {
      "output": "static",
      "favicon": "./public/favicon.png",
      "name": "vium",
      "shortName": "vium",
      "themeColor": "#ffffff",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Paperlogy-1Thin.ttf",
            "./assets/fonts/Paperlogy-2ExtraLight.ttf",
            "./assets/fonts/Paperlogy-3Light.ttf",
            "./assets/fonts/Paperlogy-4Regular.ttf",
            "./assets/fonts/Paperlogy-5Medium.ttf",
            "./assets/fonts/Paperlogy-6SemiBold.ttf",
            "./assets/fonts/Paperlogy-7Bold.ttf",
            "./assets/fonts/Paperlogy-8ExtraBold.ttf",
            "./assets/fonts/Paperlogy-9Black.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "앱에서 사진을 선택할 수 있도록 허용해주세요.",
          "cameraPermission": "앱에서 카메라를 사용할 수 있도록 허용해주세요."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 주변 나눔·판매 글을 보여주기 위해 위치를 사용해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "061074a9-2855-4362-9833-31427026dd41"
      },
      "apiBaseUrl": "https://api.vium.site"
    }
  }
}
